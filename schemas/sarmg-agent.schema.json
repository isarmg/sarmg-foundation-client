{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isarmg/sarmg-foundation-agent/schemas/sarmg-agent.schema.json",
  "title": "Sarmg Agent product manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "product_id",
    "foundation",
    "components",
    "source_roots"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_generation",
        "version"
      ],
      "properties": {
        "platform_generation": {
          "const": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profile",
          "capabilities"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "capabilities": {
                  "contains": {
                    "const": "bounded-spool"
                  }
                }
              }
            },
            "then": {
              "required": [
                "agent_limits"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "agent_limits"
                ]
              }
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "profile": {
            "enum": [
              "desktop-agent",
              "mobile-agent"
            ]
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            }
          },
          "agent_limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_record_bytes",
              "max_spool_bytes",
              "max_spool_entries"
            ],
            "properties": {
              "max_record_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "max_spool_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "max_spool_entries": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
